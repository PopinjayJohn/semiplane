package components

// The two states below are `components/ui`'s, alongside the other nine of
// UI §4.7's, so the whole set is in one package and a state added in P6 has one
// obvious home. This file names the campaign's *routes* — the addresses, which
// are URL scheme decisions — and hands the ui package its wording.

import (
	"github.com/semiplane/semiplane/internal/web/components/ui"
)

// campaignsPageName is this route's own name in a document title (UI §7.2's
// first part). The plural is what the reader is looking at, not the singular
// entity they will find inside it.
const campaignsPageName = "Campaigns"

// CampaignListPage renders the / document: the campaigns this account is a
// member of, or the designed first run, or the error state.
//
// This is the whole integration surface for the route. Nothing here reads a
// request, a store or a cookie, so the accessibility contract can be proven
// against fixtures before the route exists.
templ CampaignListPage(view CampaignListView) {
	@Shell(pageChrome(view.Shell, campaignsPageName), CampaignList(view), InstanceRail(view.Shell.Instance))
}

// CampaignList is the centre slot for /: the heading, then exactly one of the
// three states below it.
//
// The heading belongs to the route rather than to the state, which is what
// makes "exactly one <h1> per page" (UI §7.2) structural here instead of a
// thing each state has to remember. A reader who lands on the error page still
// gets told where they are.
templ CampaignList(view CampaignListView) {
	<h1 data-testid="campaigns-heading">Campaigns</h1>
	if view.Failure != nil {
		// `components.LoadFailure` is an alias of `ui.LoadFailure`, so this is a
		// dereference of the same value the route built — no conversion, and no
		// second type that could hold different fields.
		@ui.LoadError(*view.Failure)
	} else if len(view.Campaigns) == 0 {
		// Two fields out of three: `Heading` stays at its zero value,
		// `HeadingInPage`, because the `<h1>` above is the route's and §7.2 wants
		// exactly one of them.
		@ui.FirstRun(ui.FirstRunView{CreateHref: view.CreateHref, DocsHref: view.DocsHref})
	} else {
		<ul class="card-list" data-testid="campaign-list">
			for _, card := range view.Campaigns {
				// data-slug rather than a data-testid: a testid on every row
				// would be the same string several times over, and a hook that
				// appears more than once is a hook nothing can select. The slug
				// is the row's identity, and it is what the link carries.
				<li class="card" data-slug={ card.Slug }>
					<a class="card-link target" href={ "/c/" + card.Slug }>{ card.Name }</a>
					// No data-testid on the metadata lines: they repeat once per
					// campaign, and a hook that appears more than once in a
					// document is a hook nothing can select. data-slug on the row
					// is the locator, and the mapping from a domain role to these
					// words is asserted on NewCampaignCard directly.
					if card.Role != "" {
						<p class="card-meta">{ card.Role }</p>
					}
					if card.Visibility != "" {
						<p class="card-meta">{ card.Visibility }</p>
					}
					// UI §4.12.3's third bullet: the rejected theme reaches the
					// GM here, on the overview they already visit.
					//
					// `role="status"` and polite, not `role="alert"`. The record's
					// table reserves assertive for a thing the reader must act on
					// *now* — a 412, a lost connection, a secret reveal. A brand
					// that failed contrast has already degraded to the default, so
					// nothing is broken while they read; interrupting a screen
					// reader mid-sentence to say so would be worse than the silence.
					//
					// The `roleIsGM` guard is the point of the block, and it is here
					// as well as at the call site: a route that filled the field for
					// a player would otherwise render it, and §4.12.3 says "a GM
					// notice". Two checks of one condition, because this is the
					// surface and the other is the route that fills it.
					if card.ThemeNotice != nil && card.roleIsGM() {
						<p
							class="card-notice"
							role="status"
							aria-live="polite"
							data-testid="campaign-theme-notice"
						>
							<span class="card-notice-label">{ card.ThemeNotice.Label() }</span>
							if card.ThemeNotice.Token != "" {
								// `code` because the token is the half the GM edits, and
								// a token set in a different face reads as prose.
								<code class="card-notice-token">{ card.ThemeNotice.Token }</code>
							}
							<span class="card-notice-reason">{ card.ThemeNotice.Reason }</span>
						</p>
					}
				</li>
			}
		</ul>
	}
}