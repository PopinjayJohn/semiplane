package play

// The table's document: `GET /c/{slug}/play` as a browser receives it.
//
// # Why this is a document and not `components.CampaignShell`
//
// `components.CampaignShell` is the wiki's shell, and three of its decisions are
// wrong here rather than merely inconvenient:
//
//   - Its skip-link block is fixed at three, and UI §7.2 gives `/play` a fourth
//     ("Skip to the token list") that no other route has. A shell with a nullable
//     fourth link is a shell whose skip-link block and whose landmarks can
//     disagree — the one bug §7.2's pairing rule exists to prevent.
//   - Its centre landmark is `shellMain`, and this route's centre needs the
//     measure override, the map surface and the `<h1>` in one component.
//   - It renders the four landmarks and nothing between the rail and the footer,
//     and the action bar has to be a sibling in the grid at exactly that point.
//
// So the landmarks are still `chrome`'s — that is the whole of §3.7's argument
// for splitting them out, and a landmark written here would be a landmark whose
// markup is a function of which template called it — but the document around
// them is this file's. `internal/httpapi/plugins/document.go` is the precedent:
// a route whose document differs from the shell's composes `chrome` itself.
//
// # The four skip links, in §7.2's order
//
// Content → campaign navigation → utilities → token list. The first three are the
// record's and appear on every campaign route; the fourth is `/play`'s own and is
// the reason this file rather than the shell owns the block. Each target is a
// real element carrying `tabindex="-1"`, so activating a link moves focus to
// something a screen reader announces — and every one of them exists in this
// document, which `TestTheSkipLinkAndTheLandmarkItNamesAreOneCondition` asserts in
// both directions over the served bytes.
//
// # One document, whatever the device
//
// Nothing here reads a tier, a form factor or a pointer type. `data-route="play"`
// on `<body>` is the stylesheet's hook and nothing more: it says *which route*
// this is, which is a fact about the URL, and every per-tier decision — where the
// action bar sits, whether the rail is a sheet, whether the map takes a gesture —
// is in `play.css` as a `:root[data-ui="…"]` rule (UI §3.7, ADR 0034).

import (
	"github.com/semiplane/semiplane/internal/httpapi/shell"
	"github.com/semiplane/semiplane/internal/web/components/chrome"
	"github.com/semiplane/semiplane/internal/web/components/ui"
)

// Document renders the table's whole document.
//
// `rail` is the utilities rail's contents — this route's tabbed rail — passed
// rather than built here for the reason `chrome.UtilitiesRail` takes it: the
// landmark is chrome's and the panels are the route's.
templ Document(view DocumentView, rail templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// §3.7: a visitor with no script still gets the operating system's
			// polarity instead of a page pinned to one theme.
			<meta name="color-scheme" content="light dark"/>
			<title>{ view.Title }</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			// §3.7's one blocking inline script, before the stylesheet link, so
			// `data-theme` and `data-ui` are both resolved before the first paint.
			@shell.Resolver()
		</head>
		<body data-route="play">
			// §7.2 fixes the order and the position: the first focusable elements
			// in the document, before the banner.
			@ui.SkipLink("main", "Skip to content", "skip-to-content")
			@ui.SkipLink("nav", "Skip to campaign navigation", "skip-to-nav")
			@ui.SkipLink("rail", "Skip to utilities", "skip-to-utilities")
			@ui.SkipLink(PanelRegionID, "Skip to the token list", "skip-to-token-list")
			<div class="shell shell--play" data-testid="shell">
				@chrome.Header(view.Header)
				@chrome.CampaignNav(view.Nav)
				<main id="main" class="shell-main target" role="main" tabindex="-1" data-testid="shell-main">
					<h1 id="page-heading" class="play-heading" data-testid="page-title">{ view.Heading }</h1>
					@scene(view.Scene)
				</main>
				@chrome.UtilitiesRail(rail)
				// Between the rail and the footer, because that is where the grid
				// has a row for it: the bar is a sibling of the landmarks rather
				// than a child of any of them, so it is neither inside the
				// navigation it replaces nor inside the footer it sits beside.
				@actionBar(view.Actions)
				@chrome.Footer(view.Footer)
			</div>
			// The tabletop's own modules. Inline and deferred — see `client.go`.
			@ClientScripts()
		</body>
	</html>
}

// scene is the map surface, or §4.7's designed empty state.
//
// # The empty branch renders no `data-map-surface`, and that is the whole point
//
// `static/js/map/table.js` walks `[data-map-surface]` on load and **refuses** a
// surface with no `data-map-src`. So the two branches are not "a map" and "a map
// with nothing in it": a surface without an image is a surface that throws on
// every load of every table, and the error would be indistinguishable from a
// renderer defect. An absent surface is the honest markup, and
// `TestTheMapSurfaceIsAbsentWhenThereIsNoScene` holds the branch.
//
// `aria-hidden` on the surface is the client's own precondition, asserted by the
// client before it does anything else: a surface that is not hidden announces an
// unlabelled graphic, and no amount of correct drawing fixes that. `table.js`
// sets the same attribute on the canvas it creates, because the canvas did not
// exist when this was rendered. (The comment sits here rather than in the tag
// because templ's parser rejects a `//` comment inside an attribute list —
// measured: it reports `if: expected nodes` at the *else* above, naming the
// wrong line entirely.)
templ scene(view SceneView) {
	if view.Source == "" {
		<div class="play-map play-map--empty" data-testid="play-map-empty">
			<p class="empty">This table has no scene to show yet.</p>
		</div>
	} else {
		<div
			class="play-map"
			data-map-surface
			data-map-src={ view.Source }
			if view.Width != "" {
				data-map-width={ view.Width }
			}
			if view.Height != "" {
				data-map-height={ view.Height }
			}
			if view.Grid != "" {
				data-map-grid={ view.Grid }
			}
			aria-hidden="true"
			data-testid="play-map"
		></div>
	}
}

// actionBar is UI §4.9's four controls, in the order §4.9 lists them.
//
// # A `<nav>` and not a `<div>`
//
// §7.2's landmark list is `header · nav · main · aside · footer`, and it requires
// *distinguishing labels* wherever a document carries more than one `nav`. This
// document carries two — the campaign navigation ("Campaign") and this bar — and
// the compact footer bar is absent because `chrome.Footer` renders `Play` rather
// than `Bar`. "Table actions" is therefore the second label, and it is a claim
// about what the bar does rather than where it is.
//
// # Two of the four are `aria-disabled`, not `disabled`
//
// §4.9 asks for "disabled with a **stated reason**", and a native `disabled`
// button is not focusable — so its `aria-describedby` is never read by anyone,
// and the stated reason exists only in the markup. `aria-disabled` keeps the
// control in the tab order, which is the one property that makes the reason
// reachable at all, and `aria-disabled` *is* the ARIA disabled state: assistive
// technology reports the control as unavailable, and a client that later wires it
// removes the attribute rather than replacing the element.
//
// The cost is stated rather than hidden: a sighted reader who cannot focus the
// control sees no reason at rest. It is in `title` for a pointer, and in a
// visually-hidden node for everybody else — and a 4.5rem bar carrying four
// controls at 320px has no room for two sentences of prose without pushing the
// primary action off the screen.
templ actionBar(view ActionBarView) {
	<nav class="play-actions" role="navigation" aria-label={ ActionsLabel } data-testid={ ActionsTestID }>
		<button
			type="button"
			class={ ui.TargetClass + " button play-actions-item play-actions-token" }
			aria-controls={ TokenControls }
			aria-expanded="false"
			data-chrome="rail-toggle"
			data-testid={ TokenTestID }
		>Token</button>
		@ui.Dialog(view.dialog())
		<button
			type="button"
			class={ ui.TargetClass + " button play-actions-item" }
			aria-disabled="true"
			aria-describedby={ EndTurnReasonID }
			title={ EndTurnReason }
			data-testid={ EndTurnTestID }
		>End turn</button>
		<span id={ EndTurnReasonID } class="visually-hidden">{ EndTurnReason }</span>
		<button
			type="button"
			class={ ui.TargetClass + " button play-actions-item" }
			aria-disabled="true"
			aria-describedby={ ChatReasonID }
			title={ ChatReason }
			data-testid={ ChatTestID }
		>Chat</button>
		<span id={ ChatReasonID } class="visually-hidden">{ ChatReason }</span>
	</nav>
}

// rollBody is the die sheet's contents: the example, then the system's terms.
//
// `Grammar()` is the authority on what a valid expression looks like (§10.3: the
// table is data and the resolver reads it), so this renders the system's own
// notation and never a `d20` of its own — which is the sentence
// `rules.Grammar`'s doc comment opens with: "the protocol never assumes d20".
// A build with no grammar renders the honest empty state instead of a heading
// over an empty list.
templ rollBody(view RollView) {
	if !view.available() {
		<p class="empty" data-testid="play-roll-empty">{ RollUnavailable }</p>
	} else {
		if view.Example != "" {
			<p class="panel-note" data-testid="play-roll-example">
				<code>{ view.Example }</code>
			</p>
		}
		<ul class="card-list roll-terms" data-testid="play-roll-terms">
			for _, term := range view.Terms {
				<li class="roll-term">
					<span class="roll-term-name">{ term.Name }</span>
					if term.Summary != "" {
						<span class="roll-term-summary">{ term.Summary }</span>
					}
				</li>
			}
		</ul>
	}
}
